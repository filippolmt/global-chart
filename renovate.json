{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "Version pins in the Makefile, each annotated with a `# renovate:` comment. Renovate ships no Makefile manager, so without this they drift silently.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n[A-Z_]+ *:= *(?<currentValue>\\S+)"
      ]
    }
  ]
}

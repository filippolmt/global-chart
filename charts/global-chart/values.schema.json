{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "$ref": "#/$defs/global" },
    "nameOverride": {
      "description": "Replaces the chart name in the fullname and in app.kubernetes.io/name. A DNS-1123 subdomain, the loosest name it reaches; the stricter labels it can reach are checked at render time, where the release name is visible (issue #120). The empty string means no override.",
      "anyOf": [{ "const": "" }, { "$ref": "#/$defs/dns1123Subdomain" }]
    },
    "fullnameOverride": {
      "description": "Replaces the fullname that heads every generated name. A DNS-1123 subdomain, the loosest name it reaches; the stricter labels it can reach are checked at render time, where the release name is visible (issue #120). The empty string means no override.",
      "anyOf": [{ "const": "" }, { "$ref": "#/$defs/dns1123Subdomain" }]
    },
    "deployments": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/deploymentName" },
      "additionalProperties": { "$ref": "#/$defs/deployment" }
    },
    "ingress": { "$ref": "#/$defs/ingress" },
    "httpRoute": { "$ref": "#/$defs/httpRoute" },
    "cronJobs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/jobName" },
      "additionalProperties": { "$ref": "#/$defs/cronJob" }
    },
    "hooks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/hookType" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/jobName" },
        "additionalProperties": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hookJob" }
          ]
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/dns1123Subdomain" },
      "additionalProperties": { "$ref": "#/$defs/externalSecret" }
    },
    "kedaTriggerAuthentications": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/dns1123Subdomain" },
      "additionalProperties": { "$ref": "#/$defs/kedaTriggerAuthentication" }
    },
    "defaults": { "$ref": "#/$defs/defaults" },
    "rbacs": { "$ref": "#/$defs/rbacs" }
  },
  "$defs": {
    "imagePullSecret": {
      "description": "A pull secret by name: a string, or a map with only name.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": { "name": { "type": "string" } },
          "required": ["name"],
          "additionalProperties": false
        }
      ]
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/imagePullSecret" }
        },
        "commonLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "commonAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "image": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "description": "Full image string, e.g. nginx:1.25"
        },
        {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": ["string", "number"] },
            "digest": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          },
          "additionalProperties": { "type": ["string", "number"] }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          },
          "additionalProperties": { "type": ["string", "number"] }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            },
            "required": ["name"]
          }
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "description": "Kubernetes probe configuration (httpGet, tcpSocket, exec, grpc). Accepts any key: this is a Kubernetes passthrough surface, left open by ADR 0006."
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": {
          "description": "ServiceAccount name: a DNS-1123 subdomain of at most 253 characters. The empty string means the scope's default name.",
          "anyOf": [
            { "const": "" },
            { "$ref": "#/$defs/dns1123Subdomain", "maxLength": 253 }
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "portName": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/ianaSvcName" }] },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": {
          "oneOf": [
            { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/ianaSvcName" }] },
            { "type": "integer", "minimum": 1, "maximum": 65535 }
          ]
        },
        "protocol": {
          "type": "string",
          "enum": ["TCP", "UDP", "SCTP"]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "$ref": "#/$defs/ianaSvcName" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "targetPort": {
                "oneOf": [
                  { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/ianaSvcName" }] },
                  { "type": "integer", "minimum": 1, "maximum": 65535 }
                ]
              },
              "protocol": {
                "type": "string",
                "enum": ["TCP", "UDP", "SCTP"]
              },
              "appProtocol": { "type": "string" },
              "nodePort": { "type": "integer", "minimum": 30000, "maximum": 32767 }
            },
            "required": ["name", "port", "targetPort"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "if": { "required": ["extraPorts"], "properties": { "extraPorts": { "minItems": 1 } } },
      "then": { "properties": { "portName": { "minLength": 1 } } },
      "description": "An empty portName is accepted only while the Service has one port: with extraPorts it is multi-port, and the API server requires every port of a multi-port Service to be named."
    },
    "hpaTargetPercent": {
      "type": ["integer", "string"],
      "pattern": "^(0|[1-9][0-9]*)?$",
      "minimum": 0,
      "description": "0 or \"\" turns this metric off. A string holds digits only: \"80%\" is rejected, and so is a leading zero, which prints unquoted and reads as octal. With enabled: true at least one of the two targets must be positive."
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "$ref": "#/$defs/hpaTargetPercent" },
        "targetMemoryUtilizationPercentage": { "$ref": "#/$defs/hpaTargetPercent" },
        "behavior": { "type": "object" }
      },
      "additionalProperties": false
    },
    "kedaScaledObject": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "minReplicaCount": { "type": "integer", "minimum": 0 },
        "maxReplicaCount": { "type": "integer", "minimum": 0 },
        "idleReplicaCount": { "type": "integer", "minimum": 0 },
        "pollingInterval": { "type": "integer", "minimum": 0 },
        "cooldownPeriod": { "type": "integer", "minimum": 0 },
        "initialCooldownPeriod": { "type": "integer", "minimum": 0 },
        "fallback": {
          "type": "object",
          "properties": {
            "failureThreshold": { "type": "integer", "minimum": 0 },
            "replicas": { "type": "integer", "minimum": 0 },
            "behavior": { "type": "string" }
          },
          "additionalProperties": false
        },
        "advanced": {
          "type": "object",
          "properties": {
            "restoreToOriginalReplicaCount": { "type": "boolean" },
            "horizontalPodAutoscalerConfig": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "behavior": { "type": "object" }
              },
              "additionalProperties": false
            },
            "scalingModifiers": { "type": "object" }
          },
          "additionalProperties": false
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/kedaTrigger" }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": { "required": ["triggers"] }
    },
    "toleration": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "operator": { "type": "string", "enum": ["Exists", "Equal"] },
        "value": {
          "description": "A string, as Toleration.value is: quote a number (\"1\").",
          "type": "string"
        },
        "effect": { "type": "string", "enum": ["", "NoSchedule", "PreferNoSchedule", "NoExecute"] },
        "tolerationSeconds": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "hostAlias": {
      "type": "object",
      "required": ["ip"],
      "properties": {
        "ip": { "type": "string" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "dnsConfigOption": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "value": {
          "description": "PodDNSConfigOption.value is a string; a number is printed in digits and quoted by the template (printScalar), so ndots: 2 is accepted.",
          "type": ["string", "number"]
        }
      },
      "additionalProperties": false
    },
    "kedaSecretTargetRef": {
      "type": "object",
      "required": ["parameter", "name", "key"],
      "properties": {
        "parameter": { "type": "string" },
        "name": { "type": "string" },
        "key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "kedaEnvRef": {
      "type": "object",
      "required": ["parameter", "name"],
      "properties": {
        "parameter": { "type": "string" },
        "name": { "type": "string" },
        "containerName": { "type": "string" }
      },
      "additionalProperties": false
    },
    "envVar": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "value": {
          "description": "A string, as EnvVar.value is: quote a number (\"10\"), or the API server rejects the manifest.",
          "type": "string"
        },
        "valueFrom": { "type": "object" }
      },
      "additionalProperties": false
    },
    "kedaTrigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "metricType": {
          "type": "string",
          "enum": ["AverageValue", "Value", "Utilization"]
        },
        "useCachedMetrics": { "type": "boolean" },
        "metadata": {
          "description": "map[string]string in the ScaledObject: quote a number (\"10\").",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "authenticationRef": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "kedaTriggerAuthentication": {
      "type": "object",
      "properties": {
        "secretTargetRef": { "type": "array", "items": { "$ref": "#/$defs/kedaSecretTargetRef" } },
        "env": { "type": "array", "items": { "$ref": "#/$defs/kedaEnvRef" } },
        "podIdentity": { "type": "object" },
        "hashiCorpVault": { "type": "object" },
        "azureKeyVault": { "type": "object" },
        "awsSecretManager": { "type": "object" },
        "gcpSecretManager": { "type": "object" }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "description": "A count as an integer, or a percentage as a string (\"25%\"). A digit string with no percent sign is rejected: spell a count as a number.",
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ]
        },
        "maxUnavailable": {
          "description": "A count as an integer, or a percentage as a string (\"25%\"). A digit string with no percent sign is rejected: spell a count as a number.",
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+%$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "policyTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ingress": { "type": "array" },
        "egress": { "type": "array" }
      },
      "additionalProperties": false
    },
    "dnsConfig": {
      "type": "object",
      "properties": {
        "nameservers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "searches": {
          "type": "array",
          "items": { "type": "string" }
        },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/dnsConfigOption" }
        }
      },
      "additionalProperties": false
    },
    "deploymentName": {
      "description": "Key of the deployments map. It lands raw in the 'app.kubernetes.io/component' label value, as part of the container name, and as '<key>-hook' when the deployment has hooks: a DNS-1123 label, capped at 58 so that the '-hook' suffix fits. The cap holds even without hooks, so adding a hook later cannot invalidate a key that was valid.",
      "$ref": "#/$defs/dns1123Label",
      "maxLength": 58
    },
    "jobName": {
      "description": "Key of a cronJobs or hooks.<type> map, at either scope. At deployment scope it becomes the container name raw, a DNS-1123 label; the root scope goes through a truncated fullname, but one rule holds for both.",
      "$ref": "#/$defs/dns1123Label",
      "maxLength": 63
    },
    "hookType": {
      "description": "Key of a hooks map: a Helm hook type, lowercase. An unknown type renders and Helm drops the resource with an INFO log and exit 0; at deployment scope it also drops the shared prereq ConfigMap/Secret, whose helm.sh/hook joins every type. Helm accepts an uppercase type, but the chart's checks are case-sensitive. 'test-success' is Helm's alias of 'test'.",
      "type": "string",
      "enum": [
        "pre-install",
        "post-install",
        "pre-upgrade",
        "post-upgrade",
        "pre-delete",
        "post-delete",
        "pre-rollback",
        "post-rollback",
        "test",
        "test-success"
      ]
    },
    "dns1123Label": {
      "description": "A DNS-1123 label: lowercase alphanumerics and '-', starting and ending with an alphanumeric. The length bound is the caller's, via maxLength next to the $ref: it depends on what the value is joined to.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "ianaSvcName": {
      "description": "An IANA_SVC_NAME, as Kubernetes validates a Service port name, a container port name and a named targetPort: at most 15 characters, lowercase alphanumerics and '-', no leading, trailing or doubled '-', and at least one letter. Two patterns under allOf because Go regexp has no lookahead: the first fixes the shape, the second the letter. portName and targetPort also accept \"\": the API server takes it on a single-port Service (targetPort defaults to port), so it is not rejected here; extraPorts[].name never does, since extra ports make the Service multi-port.",
      "type": "string",
      "maxLength": 15,
      "allOf": [
        { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        { "pattern": "[a-z]" }
      ]
    },
    "dns1123Subdomain": {
      "description": "A DNS-1123 subdomain: dot-separated DNS-1123 labels. Constrains the keys of the externalSecrets and kedaTriggerAuthentications maps, which become part of a resource name, rbacs.roles[].name, which becomes the Role, RoleBinding and default ServiceAccount names, serviceAccount.name / serviceAccountName in every scope, and nameOverride / fullnameOverride. No maxLength here: the map keys are prefixed by the fullname, which the schema cannot see; the names used verbatim add maxLength 253 at their call site.",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "mountedConfigFileName": {
      "description": "Name of a mounted config file entry. Bounded at 52 chars because it feeds the pod volume name 'md-cm-file-<name>', a DNS-1123 label capped at 63. The same bound applies to bundle entries even though 'md-cm-bundle-<i>' has room: one number, taken from the tightest side.",
      "$ref": "#/$defs/dns1123Label",
      "maxLength": 52
    },
    "mountedConfigFiles": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "$ref": "#/$defs/mountedConfigFileName" },
              "filename": { "type": "string" },
              "targetPath": { "type": "string" },
              "mountPath": { "type": "string", "deprecated": true, "description": "DEPRECATED and read by no template: it is targetPath that sets where the file is mounted. Kept only because additionalProperties is false, which makes removal breaking; it goes at the next major. The one knowing exception to the 'every schema field is used by a template' rule in CLAUDE.md." },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mountDir": { "type": "string" },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "$ref": "#/$defs/mountedConfigFileName" },
                    "relPath": { "type": "string" },
                    "content": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/image" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "imagePullSecrets": { "type": "array", "items": { "$ref": "#/$defs/imagePullSecret" } },
        "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
        "annotations": {
          "description": "Annotations on the Deployment's own metadata, merged over global.commonAnnotations. Not podAnnotations, and not propagated to the Service, ServiceAccount, HPA or any other resource of the deployment.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" },
        "service": { "$ref": "#/$defs/service" },
        "resources": { "$ref": "#/$defs/resources" },
        "livenessProbe": { "$ref": "#/$defs/probe" },
        "readinessProbe": { "$ref": "#/$defs/probe" },
        "startupProbe": { "$ref": "#/$defs/probe" },
        "lifecycle": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "autoscaling": { "$ref": "#/$defs/autoscaling" },
        "keda": { "$ref": "#/$defs/kedaScaledObject" },
        "strategy": { "type": "object" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "topologySpreadConstraints": { "type": "array" },
        "pdb": { "$ref": "#/$defs/pdb" },
        "networkPolicy": { "$ref": "#/$defs/networkPolicy" },
        "volumes": { "type": "array" },
        "volumeMounts": { "type": "array" },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tolerations": { "type": "array", "items": { "$ref": "#/$defs/toleration" } },
        "affinity": { "type": "object" },
        "secret": { "type": "object", "additionalProperties": {} },
        "configMap": { "type": "object", "additionalProperties": {} },
        "hostAliases": { "type": "array", "items": { "$ref": "#/$defs/hostAlias" } },
        "dnsConfig": { "$ref": "#/$defs/dnsConfig" },
        "envFromConfigMaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "envFromSecrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalSecrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalSecretRef" }
        },
        "additionalEnvs": { "type": "array", "items": { "$ref": "#/$defs/envVar" } },
        "extraInitContainers": { "type": "array" },
        "extraContainers": { "type": "array" },
        "podRecreation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "mountedConfigFiles": { "$ref": "#/$defs/mountedConfigFiles" },
        "hooks": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/hookType" },
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/jobName" },
            "additionalProperties": { "$ref": "#/$defs/deploymentHookJob" }
          }
        },
        "cronJobs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/jobName" },
          "additionalProperties": { "$ref": "#/$defs/deploymentCronJob" }
        }
      },
      "additionalProperties": false
    },
    "jobCommon": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "resources": { "$ref": "#/$defs/resources" },
        "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
        "serviceAccountName": {
          "description": "Existing ServiceAccount the job runs as. Same rule as serviceAccount.name: a DNS-1123 subdomain of at most 253 characters; null or \"\" means unset.",
          "anyOf": [
            { "type": "null" },
            { "const": "" },
            { "$ref": "#/$defs/dns1123Subdomain", "maxLength": 253 }
          ]
        },
        "serviceAccountAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "imagePullSecrets": { "type": "array", "items": { "$ref": "#/$defs/imagePullSecret" } },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tolerations": { "type": "array", "items": { "$ref": "#/$defs/toleration" } },
        "affinity": { "type": "object" },
        "hostAliases": { "type": "array", "items": { "$ref": "#/$defs/hostAlias" } },
        "dnsConfig": { "$ref": "#/$defs/dnsConfig" },
        "env": { "type": "array", "items": { "$ref": "#/$defs/envVar" } },
        "envFromConfigMaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "envFromSecrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "externalSecrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalSecretRef" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "automountServiceAccountToken": { "type": "boolean" },
        "volumes": { "type": "array" },
        "volumeMounts": { "type": "array" },
        "restartPolicy": { "type": "string", "enum": ["OnFailure", "Never"] },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "cronJobSpec": {
      "type": "object",
      "required": ["schedule"],
      "properties": {
        "schedule": { "type": "string" },
        "initContainers": { "type": "array" },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "parallelism": { "type": "integer", "minimum": 0 },
        "completions": { "type": "integer", "minimum": 1 },
        "timeZone": { "type": "string" },
        "suspend": { "type": "boolean" },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Allow", "Forbid", "Replace"]
        }
      }
    },
    "hookJobSpec": {
      "type": "object",
      "properties": {
        "weight": { "type": ["string", "integer"], "pattern": "^-?(0|[1-9][0-9]*)$", "description": "Hook weight. A string holds a plain integer: a leading zero is rejected, since the weight arithmetic would read \"010\" as octal 8." },
        "deletePolicy": { "type": "string" },
        "activeDeadlineSeconds": {
          "description": "Bound on the hook Job's run time. The only bound on a hook pod that waits for a Secret: it never reaches Failed, so backoffLimit never counts it.",
          "type": "integer",
          "minimum": 1
        },
        "backoffLimit": {
          "description": "Retries before the hook Job is marked failed; Kubernetes defaults to 6. The hook's own: no fallback from the deployment or global. Why the other Job spec fields are not offered on a hook: see jobSpecVerbatimFields in _job-helpers.tpl.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rootJobSpec": {
      "type": "object",
      "properties": {
        "fromDeployment": { "type": "string" }
      }
    },
    "deploymentJobSpec": {
      "type": "object",
      "properties": {
        "inheritDeploymentConfigMap": { "type": "boolean" },
        "inheritDeploymentSecret": { "type": "boolean" }
      }
    },
    "cronJob": {
      "allOf": [
        { "$ref": "#/$defs/jobCommon" },
        { "$ref": "#/$defs/cronJobSpec" },
        { "$ref": "#/$defs/rootJobSpec" }
      ],
      "unevaluatedProperties": false
    },
    "deploymentCronJob": {
      "allOf": [
        { "$ref": "#/$defs/jobCommon" },
        { "$ref": "#/$defs/cronJobSpec" },
        { "$ref": "#/$defs/deploymentJobSpec" }
      ],
      "unevaluatedProperties": false
    },
    "hookJob": {
      "allOf": [
        { "$ref": "#/$defs/jobCommon" },
        { "$ref": "#/$defs/hookJobSpec" },
        { "$ref": "#/$defs/rootJobSpec" }
      ],
      "unevaluatedProperties": false
    },
    "deploymentHookJob": {
      "allOf": [
        { "$ref": "#/$defs/jobCommon" },
        { "$ref": "#/$defs/hookJobSpec" },
        { "$ref": "#/$defs/deploymentJobSpec" }
      ],
      "unevaluatedProperties": false
    },
    "externalSecretRemote": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "conversionStrategy": { "type": "string" },
        "decodingStrategy": { "type": "string" },
        "metadataPolicy": { "type": "string" },
        "property": { "type": "string" },
        "version": { "type": ["string", "number"] }
      },
      "additionalProperties": false
    },
    "externalSecretRef": {
      "description": "A reference to a key of the root externalSecrets map, never to the Secret it produces. Without mountPath the Secret is an envFrom source; with it, a read-only volume mounted there. A pre-* hook other than pre-delete, and a post-delete hook, read the Secret of the hook-prerequisite copy (ADR 0007).",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mountPath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "annotations": {
          "description": "Annotations on the ExternalSecret, merged over global.commonAnnotations. Not copied onto its hook-prerequisite copy, which is ordered by hook phase (ADR 0007).",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "remote": { "$ref": "#/$defs/externalSecretRemote" },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretkey": { "type": "string" },
              "remote": { "$ref": "#/$defs/externalSecretRemote" }
            },
            "additionalProperties": false
          }
        },
        "dataFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "extract": { "type": "object" },
              "find": { "type": "object" },
              "rewrite": { "type": "array" },
              "sourceRef": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "secretstore": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["ClusterSecretStore", "SecretStore"]
            },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        },
        "secretkey": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "target": {
          "type": "object",
          "properties": {
            "creationPolicy": { "type": "string", "enum": ["Owner", "Orphan", "Merge", "None", "CreateOrMerge"], "description": "ESO's target.creationPolicy; Owner when unset. CreateOrMerge needs an ESO release that ships it." },
            "deletionPolicy": { "type": "string", "enum": ["Delete", "Merge", "Retain"] },
            "name": { "type": "string" },
            "immutable": { "type": "boolean" },
            "template": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": { "type": "string" }
              },
              "secretName": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "deployment": { "type": "string" },
              "service": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                },
                "additionalProperties": false
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": ["paths"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "sectionName": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "kind": { "type": "string" },
              "group": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpRouteRule" }
        }
      }
    },
    "httpRouteRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "path": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["Exact", "PathPrefix", "RegularExpression"]
                  },
                  "value": { "type": "string" }
                }
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["Exact", "RegularExpression"]
                    },
                    "name": { "type": "string" },
                    "value": { "type": "string" }
                  },
                  "required": ["name", "value"]
                }
              },
              "queryParams": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["Exact", "RegularExpression"]
                    },
                    "name": { "type": "string" },
                    "value": { "type": "string" }
                  },
                  "required": ["name", "value"]
                }
              },
              "method": {
                "type": "string",
                "enum": ["GET", "HEAD", "POST", "PUT", "DELETE", "CONNECT", "OPTIONS", "TRACE", "PATCH"]
              }
            }
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RequestHeaderModifier",
                  "ResponseHeaderModifier",
                  "RequestRedirect",
                  "URLRewrite",
                  "RequestMirror",
                  "ExtensionRef"
                ]
              }
            },
            "required": ["type"]
          }
        },
        "backendRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deployment": { "type": "string" },
              "service": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                }
              },
              "weight": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "RequestHeaderModifier",
                        "ResponseHeaderModifier",
                        "RequestRedirect",
                        "URLRewrite",
                        "RequestMirror",
                        "ExtensionRef"
                      ]
                    }
                  },
                  "required": ["type"]
                }
              }
            }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": { "type": "string" },
            "backendRequest": { "type": "string" }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "resources": { "$ref": "#/$defs/resources" }
      },
      "additionalProperties": false
    },
    "rbacs": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "rules"],
            "properties": {
              "name": { "$ref": "#/$defs/dns1123Subdomain", "maxLength": 253 },
              "serviceAccount": { "$ref": "#/$defs/serviceAccount" },
              "rules": {
                "type": "array",
                "items": { "type": "object" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
